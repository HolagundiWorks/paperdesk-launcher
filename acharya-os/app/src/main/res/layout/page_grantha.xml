<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="36dp"
        android:paddingTop="@dimen/page_pad_top"
        android:paddingRight="@dimen/page_pad_h"
        android:paddingBottom="@dimen/page_pad_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/granthaHead"
                style="@style/Desk.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/accent" />

            <TextView
                android:id="@+id/granthaStar"
                style="@style/Desk.CircleText"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="@string/star_off"
                android:textColor="@color/white_55"
                android:textSize="@dimen/type_title"
                android:visibility="gone" />
        </LinearLayout>

        <com.paperdesk.launcher.ui.DeskScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_8"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <TextView
                android:id="@+id/granthaBody"
                style="@style/Desk.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.35"
                android:textColor="@color/white" />
        </com.paperdesk.launcher.ui.DeskScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/granthaBook"
                style="@style/Desk.Link"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:paddingLeft="0dp"
                android:textColor="@color/accent" />

            <TextView
                android:id="@+id/granthaLeaf"
                style="@style/Desk.Link"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_8"
                android:layout_weight="1.6"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/granthaSearch"
                style="@style/Desk.CircleText"
                android:layout_marginLeft="@dimen/space_8"
                android:text="⌕" />

            <TextView
                android:id="@+id/granthaPrev"
                style="@style/Desk.CircleText"
                android:layout_marginLeft="@dimen/space_8"
                android:text="‹" />

            <TextView
                android:id="@+id/granthaNext"
                style="@style/Desk.CircleText"
                android:layout_marginLeft="@dimen/space_8"
                android:background="@drawable/bg_circle_on"
                android:text="›"
                android:textColor="@color/accent" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
