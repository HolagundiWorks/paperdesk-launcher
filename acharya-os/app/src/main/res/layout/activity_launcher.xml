<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcherRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.paperdesk.launcher.ui.ZonePagerHost
        android:id="@+id/pagerHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:background="@color/black" />
    </com.paperdesk.launcher.ui.ZonePagerHost>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pageNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_footer_height"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_nav_bar"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/ui_content_inset"
        android:paddingRight="@dimen/ui_content_inset">

        <ImageButton
            android:id="@+id/navPrev"
            style="@style/Desk.Circle"
            android:layout_width="@dimen/ui_footer_control"
            android:layout_height="@dimen/ui_footer_control"
            android:contentDescription="@string/prev"
            android:src="@drawable/ic_nav_prev"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/pageCurrent"
            style="@style/Desk.Section"
            android:layout_width="128dp"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/ui_grid_1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/navPrev"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/hariMotto"
            style="@style/Desk.Meta"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="@dimen/space_8"
            android:paddingRight="@dimen/space_8"
            android:textColor="@color/white_55"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/navAction"
            style="@style/Desk.Circle"
            android:layout_width="@dimen/ui_footer_control"
            android:layout_height="@dimen/ui_footer_control"
            android:contentDescription="ಆಯ್ಕೆಪಟ್ಟಿ ತೆರೆಯಿರಿ"
            android:src="@drawable/ic_expand"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/navNext"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/navNext"
            style="@style/Desk.Circle"
            android:layout_width="@dimen/ui_footer_control"
            android:layout_height="@dimen/ui_footer_control"
            android:contentDescription="@string/next"
            android:src="@drawable/ic_nav_next"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/shadeGuard"
        android:layout_width="match_parent"
        android:layout_height="19.2dp"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/unlock">

        <View
            android:layout_width="38.4dp"
            android:layout_height="2.4dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="3.2dp"
            android:background="@color/white_55"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <include layout="@layout/panel_controls" />
</FrameLayout>
