<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="@dimen/page_pad_h"
        android:paddingTop="@dimen/page_pad_top"
        android:paddingRight="@dimen/page_pad_h"
        android:paddingBottom="@dimen/space_8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.12"
            android:gravity="top"
            android:orientation="vertical">

            <TextView
                android:id="@+id/schedTitle"
                style="@style/Desk.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/page_schedule" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_standard"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_rule" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.76"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/weekGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/schedDayLabel"
                style="@style/Desk.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/schedPanchanga"
                style="@style/Desk.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textColor="@color/accent" />

            <LinearLayout
                android:id="@+id/schedEmptyBox"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/schedEmpty"
                    style="@style/Desk.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_schedules" />
            </LinearLayout>

            <com.paperdesk.launcher.ui.DeskRecyclerView
                android:id="@+id/schedList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/space_8"
                android:overScrollMode="never" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.12" />
    </LinearLayout>

    <TextView
        android:id="@+id/fabSched"
        style="@style/Desk.Fab"
        android:layout_width="@dimen/fab"
        android:layout_height="@dimen/fab" />
</FrameLayout>
