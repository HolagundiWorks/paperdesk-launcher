<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/page_pad_h"
    android:paddingTop="@dimen/page_pad_top"
    android:paddingRight="@dimen/page_pad_h"
    android:paddingBottom="@dimen/footer_bar">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.34"
        android:orientation="vertical"
        android:paddingRight="12.8dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="35.2dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/aayadiTitle" style="@style/Desk.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ಅಳತೆ ನಮೂದಿಸಿ" />
            <ImageButton android:id="@+id/aayadiInfo" style="@style/Desk.Circle" android:contentDescription="ಆಯಾದಿ ಮಾಹಿತಿ" android:src="@drawable/ic_information" />
        </LinearLayout>

        <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3.2dp" android:text="ಕಟ್ಟಡದ ಒಳ ಅಳತೆಗಳನ್ನು ಅಡಿ ಮತ್ತು ಇಂಚಿನಲ್ಲಿ ಆಯ್ಕೆಮಾಡಿ" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="9.6dp">
            <TextView style="@style/Desk.Section" android:layout_width="56dp" android:layout_height="match_parent" android:gravity="center_vertical" android:text="ಉದ್ದ" />
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಅಡಿ" />
                <Spinner android:id="@+id/aayadiLengthFt" android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="3.2dp" android:background="@drawable/bg_dropdown" android:contentDescription="ಉದ್ದ ಅಡಿ" android:popupBackground="@color/surface_2" android:spinnerMode="dropdown" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="6.4dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಇಂಚು" />
                <Spinner android:id="@+id/aayadiLengthIn" android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="3.2dp" android:background="@drawable/bg_dropdown" android:contentDescription="ಉದ್ದ ಇಂಚು" android:popupBackground="@color/surface_2" android:spinnerMode="dropdown" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="9.6dp">
            <TextView style="@style/Desk.Section" android:layout_width="56dp" android:layout_height="match_parent" android:gravity="center_vertical" android:text="ಅಗಲ" />
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಅಡಿ" />
                <Spinner android:id="@+id/aayadiBreadthFt" android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="3.2dp" android:background="@drawable/bg_dropdown" android:contentDescription="ಅಗಲ ಅಡಿ" android:popupBackground="@color/surface_2" android:spinnerMode="dropdown" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="6.4dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಇಂಚು" />
                <Spinner android:id="@+id/aayadiBreadthIn" android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="3.2dp" android:background="@drawable/bg_dropdown" android:contentDescription="ಅಗಲ ಇಂಚು" android:popupBackground="@color/surface_2" android:spinnerMode="dropdown" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/aayadiCalculate" style="@style/Desk.Button.Accent" android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="9.6dp" android:gravity="center" android:text="ಆಯಾದಿ ಲೆಕ್ಕ ಹಾಕಿ" />
        <TextView android:id="@+id/aayadiError" style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6.4dp" android:text="ಸರಿಯಾದ ಉದ್ದ ಮತ್ತು ಅಗಲ ಆಯ್ಕೆಮಾಡಿ" android:textColor="@color/carbon_support_error" android:visibility="gone" />
    </LinearLayout>

    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/divider" />

    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.66" android:orientation="vertical" android:paddingLeft="12.8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="35.2dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/aayadiResultTitle" style="@style/Desk.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ಆಯಾದಿ ಫಲಿತಾಂಶ" />
            <TextView style="@style/Desk.Meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="೬ ಗಣನೆಗಳು" />
        </LinearLayout>

        <LinearLayout android:id="@+id/aayadiResults" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
            <GridLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:alignmentMode="alignMargins" android:columnCount="3" android:rowCount="2" android:useDefaultMargins="true">
                <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="vertical" android:padding="9.6dp">
                    <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಪದಂ" />
                    <TextView android:id="@+id/aayadiPadam" style="@style/Desk.Title.Large" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3.2dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="vertical" android:padding="9.6dp">
                    <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಆಯ" />
                    <TextView android:id="@+id/aayadiAaya" style="@style/Desk.Title.Large" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3.2dp" android:maxLines="2" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="vertical" android:padding="9.6dp">
                    <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಧನ" />
                    <TextView android:id="@+id/aayadiDhana" style="@style/Desk.Title.Large" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3.2dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="vertical" android:padding="9.6dp">
                    <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಋಣ" />
                    <TextView android:id="@+id/aayadiRuna" style="@style/Desk.Title.Large" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3.2dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="vertical" android:padding="9.6dp">
                    <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಆಯುಷ್ಯ" />
                    <TextView android:id="@+id/aayadiAyush" style="@style/Desk.Title.Large" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3.2dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="vertical" android:padding="9.6dp">
                    <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ವ್ಯಯ" />
                    <TextView android:id="@+id/aayadiVyaya" style="@style/Desk.Title.Large" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3.2dp" />
                </LinearLayout>
            </GridLayout>

            <TextView android:id="@+id/aayadiSummary" style="@style/Desk.Body" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:paddingLeft="3.2dp" android:paddingRight="3.2dp" android:textColor="@color/accent" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
