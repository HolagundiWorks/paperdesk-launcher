<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/black" android:orientation="horizontal"
    android:paddingLeft="@dimen/page_pad_h" android:paddingRight="@dimen/page_pad_h"
    android:paddingBottom="@dimen/footer_bar">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.42" android:orientation="vertical" android:paddingRight="20dp">
        <TextView android:id="@+id/aayadiTitle" style="@style/Desk.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಆಯಾದಿ ಗಣನೆ" />
        <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="ಉದ್ದ ಮತ್ತು ಅಗಲವನ್ನು ಅಡಿಗಳಲ್ಲಿ ನಮೂದಿಸಿ" />
        <TextView style="@style/Desk.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="ಉದ್ದ" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <EditText android:id="@+id/aayadiLengthFt" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_input" android:hint="ಅಡಿ" android:inputType="numberDecimal" android:padding="8dp" android:text="30" android:textColor="@color/white" android:textColorHint="@color/white_55" />
            <EditText android:id="@+id/aayadiLengthIn" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginLeft="8dp" android:background="@drawable/bg_input" android:hint="ಇಂಚು" android:inputType="numberDecimal" android:padding="8dp" android:text="0" android:textColor="@color/white" android:textColorHint="@color/white_55" />
        </LinearLayout>
        <TextView style="@style/Desk.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="ಅಗಲ" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <EditText android:id="@+id/aayadiBreadthFt" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_input" android:hint="ಅಡಿ" android:inputType="numberDecimal" android:padding="8dp" android:text="40" android:textColor="@color/white" android:textColorHint="@color/white_55" />
            <EditText android:id="@+id/aayadiBreadthIn" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginLeft="8dp" android:background="@drawable/bg_input" android:hint="ಇಂಚು" android:inputType="numberDecimal" android:padding="8dp" android:text="0" android:textColor="@color/white" android:textColorHint="@color/white_55" />
        </LinearLayout>
        <TextView android:id="@+id/aayadiCalculate" style="@style/Desk.Button.Accent" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:gravity="center" android:text="ಲೆಕ್ಕ ಹಾಕಿ" />
        <TextView android:id="@+id/aayadiError" style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="ಸರಿಯಾದ ಉದ್ದ ಮತ್ತು ಅಗಲ ನಮೂದಿಸಿ" android:textColor="@color/accent" android:visibility="gone" />
    </LinearLayout>
    <ScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.58" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/aayadiResultTitle" style="@style/Desk.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಫಲಿತಾಂಶ" />
            <LinearLayout android:id="@+id/aayadiResults" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/aayadiPadam" style="@style/Desk.Title.Large" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
                <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಪದಂ (ಉದ್ದ × ಅಗಲ)" />
                <TextView android:id="@+id/aayadiAaya" style="@style/Desk.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
                <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಆಯ  ·  ಪದಂ × 9 ÷ 8 ಶೇಷ" />
                <TextView android:id="@+id/aayadiDhana" style="@style/Desk.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಧನ  ·  ಪದಂ × 8 ÷ 12 ಶೇಷ" />
                <TextView android:id="@+id/aayadiRuna" style="@style/Desk.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಋಣ  ·  ಪದಂ × 3 ÷ 8 ಶೇಷ" />
                <TextView android:id="@+id/aayadiAyush" style="@style/Desk.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಆಯುಷ್ಯ  ·  ಪದಂ × 9 ÷ 120 ಶೇಷ" />
                <TextView android:id="@+id/aayadiVyaya" style="@style/Desk.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ವ್ಯಯ  ·  ಕಾಮಿಕ ಷಡ್ವರ್ಗ ಪರಿಶೀಲನೆ: ಉದ್ದ × 9 ÷ 10 ಶೇಷ" />
                <TextView android:id="@+id/aayadiSummary" style="@style/Desk.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/accent" />
                <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="ಇದು ಕರ್ನಾಟಕ ನವವರ್ಗದ ಕಾರ್ಯಪದ್ಧತಿಯ ಉಲ್ಲೇಖ ಗಣನೆ. ಸೂತ್ರಗಳು ಪರಂಪರೆಯಂತೆ ಬದಲಾಗುತ್ತವೆ; ನಿರ್ಮಾಣಕ್ಕೆ ಸ್ಥಪತಿ/ಗುರುವಿನ ಸಲಹೆ ಪಡೆಯಿರಿ." />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
