<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/earth_canvas_desk"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/page_pad_h"
        android:paddingTop="@dimen/page_pad_top"
        android:paddingRight="@dimen/page_pad_h"
        android:paddingBottom="@dimen/page_pad_bottom">

        <TextView android:id="@+id/settingsBack" style="@style/Desk.Link"
            android:layout_width="wrap_content" android:layout_height="@dimen/touch"
            android:gravity="center_vertical" android:text="@string/back" />

        <TextView style="@style/Desk.Title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/settings_title" />

        <TextView style="@style/Desk.Meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4"
            android:text="@string/settings_summary" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16" android:background="@drawable/bg_card"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="@dimen/space_16">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Desk.Section" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/settings_veda"
                    android:textColor="@color/accent" />
                <TextView style="@style/Desk.Meta" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4"
                    android:text="@string/settings_veda_hint" />
            </LinearLayout>
            <Spinner android:id="@+id/settingsVeda" android:layout_width="360dp"
                android:layout_height="@dimen/touch" android:layout_marginLeft="@dimen/space_16"
                android:background="@drawable/bg_dropdown" android:popupBackground="@color/surface_2" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8" android:background="@drawable/bg_card"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="@dimen/space_16">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Desk.Section" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/settings_panchanga"
                    android:textColor="@color/accent" />
                <TextView android:id="@+id/settingsPanchangaHint" style="@style/Desk.Meta"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4" />
            </LinearLayout>
            <Spinner android:id="@+id/settingsPanchanga" android:layout_width="420dp"
                android:layout_height="@dimen/touch" android:layout_marginLeft="@dimen/space_16"
                android:background="@drawable/bg_dropdown" android:popupBackground="@color/surface_2" />
        </LinearLayout>

        <TextView style="@style/Desk.Section" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16"
            android:text="@string/brand_developer" android:textColor="@color/white" />
        <TextView style="@style/Desk.Meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4"
            android:text="@string/brand_made_in" />
        <TextView android:id="@+id/settingsVersion" style="@style/Desk.Meta"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4" />
    </LinearLayout>
</ScrollView>
