<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_h"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_12"
    android:paddingBottom="@dimen/space_12">

    <ImageView
        android:id="@+id/minutesThumb"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginRight="@dimen/space_8"
        android:contentDescription="@string/photo"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/minutesTitle"
            style="@style/Desk.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/minutesBody"
            style="@style/Desk.Body2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/minutesWhen"
            style="@style/Desk.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4" />
    </LinearLayout>

    <TextView
        android:id="@+id/minutesDel"
        style="@style/Desk.IconBtn"
        android:layout_width="@dimen/icon_btn"
        android:layout_height="@dimen/icon_btn"
        android:text="x" />
</LinearLayout>
