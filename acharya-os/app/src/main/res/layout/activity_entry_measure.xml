<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/entry_pad"
        android:descendantFocusability="beforeDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:id="@+id/entryCancel"
            style="@style/Desk.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/enter_measure"
            android:textColor="@color/white"
            android:textSize="@dimen/type_title_lg"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mItemNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Description"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/mDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:hint="Item"
            android:inputType="textCapSentences"
            android:minHeight="52dp"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/accent"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Length"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/mLen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:gravity="end"
            android:hint="0"
            android:inputType="numberDecimal"
            android:minHeight="@dimen/field_h"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/accent"
            android:textSize="@dimen/type_section" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Breadth"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/mBrd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:gravity="end"
            android:hint="0"
            android:inputType="numberDecimal"
            android:minHeight="@dimen/field_h"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/accent"
            android:textSize="@dimen/type_section" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Height"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/mHt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:gravity="end"
            android:hint="0"
            android:inputType="numberDecimal"
            android:minHeight="@dimen/field_h"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/accent"
            android:textSize="@dimen/type_section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mUom"
                style="@style/Desk.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="m"
                android:textColor="@color/accent" />

            <TextView
                android:id="@+id/mKind"
                style="@style/Desk.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:text="AREA"
                android:textColor="@color/accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/mQty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:text="0.00 m2"
            android:textColor="@color/white"
            android:textSize="@dimen/type_display" />

        <TextView
            android:id="@+id/entrySave"
            style="@style/Desk.Button.Accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="52dp"
            android:text="@string/save" />

        <TextView
            android:id="@+id/entrySaveNext"
            style="@style/Desk.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_white_stroke"
            android:minHeight="52dp"
            android:text="@string/save_next" />
    </LinearLayout>
</ScrollView>
