<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="horizontal"
    android:paddingLeft="36dp"
    android:paddingTop="@dimen/page_pad_top"
    android:paddingRight="@dimen/page_pad_h"
    android:paddingBottom="@dimen/page_pad_bottom">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.38"
        android:orientation="vertical">

        <TextView
            android:id="@+id/blankTitle"
            style="@style/Desk.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/blankMeta"
            style="@style/Desk.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:textColor="@color/white_55" />
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_weight="0.62" />
</LinearLayout>
