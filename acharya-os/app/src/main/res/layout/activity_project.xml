<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/projectRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/page_pad_h"
        android:paddingTop="@dimen/space_8"
        android:paddingRight="@dimen/page_pad_h">

        <TextView
            android:id="@+id/projectBack"
            style="@style/Desk.Button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch"
            android:minHeight="@dimen/touch"
            android:text="@string/back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/projectTitle"
                style="@style/Desk.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/projectInfo"
                style="@style/Desk.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/projectEdit"
            style="@style/Desk.Button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch"
            android:minHeight="@dimen/touch"
            android:text="EDIT" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/projectFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
