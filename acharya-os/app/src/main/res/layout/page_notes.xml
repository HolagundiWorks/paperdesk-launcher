<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="@dimen/page_pad_h"
        android:paddingTop="@dimen/page_pad_top"
        android:paddingRight="@dimen/page_pad_h"
        android:paddingBottom="@dimen/page_pad_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Desk.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/page_notes" />

            <TextView
                android:id="@+id/notePhoto"
                style="@style/Desk.Button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch"
                android:text="@string/photo" />
        </LinearLayout>

        <EditText
            android:id="@+id/noteSearch"
            style="@style/Desk.Field"
            android:layout_width="match_parent"
            android:layout_height="@dimen/field_h"
            android:layout_marginTop="@dimen/space_12"
            android:hint="@string/search_notes"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <LinearLayout
            android:id="@+id/noteEmptyBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Desk.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_notes" />

            <TextView
                android:id="@+id/noteCreate"
                style="@style/Desk.Button.Accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:minWidth="200dp"
                android:text="@string/new_note" />

            <TextView
                android:id="@+id/notePhotoEmpty"
                style="@style/Desk.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:minWidth="200dp"
                android:text="@string/photo" />
        </LinearLayout>

        <com.paperdesk.launcher.ui.DeskRecyclerView
            android:id="@+id/noteList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/space_8"
            android:overScrollMode="never" />
    </LinearLayout>

    <TextView
        android:id="@+id/fabNote"
        style="@style/Desk.Fab"
        android:layout_width="@dimen/fab"
        android:layout_height="@dimen/fab" />
</FrameLayout>
