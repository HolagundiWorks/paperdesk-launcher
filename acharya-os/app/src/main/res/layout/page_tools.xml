<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:paddingLeft="@dimen/page_pad_h"
    android:paddingTop="@dimen/page_pad_top"
    android:paddingRight="@dimen/space_8"
    android:paddingBottom="@dimen/page_pad_bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/toolsModeCalc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch"
            android:gravity="center"
            android:padding="@dimen/space_8"
            android:text="@string/calculator"
            android:textColor="@color/accent"
            android:textSize="@dimen/type_body2" />

        <TextView
            android:id="@+id/toolsModeApps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch"
            android:gravity="center"
            android:padding="@dimen/space_8"
            android:text="@string/apps"
            android:textColor="@color/white"
            android:textSize="@dimen/type_body2" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/calcWorkspace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.58"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/calcSummary"
                    style="@style/Desk.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="start"
                    android:gravity="end"
                    android:maxLines="2"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:text="" />

                <TextView
                    android:id="@+id/calcDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="start"
                    android:fontFamily="sans-serif"
                    android:gravity="end"
                    android:maxLines="1"
                    android:minHeight="@dimen/touch"
                    android:padding="@dimen/space_8"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="@dimen/type_display" />

                <TextView
                    android:id="@+id/calcKind"
                    style="@style/Desk.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:text="AREA" />

                <LinearLayout
                    android:id="@+id/unitGrid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="@dimen/space_8">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Desk.Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="m" />

                            <TextView
                                android:id="@+id/unitM"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="0.00"
                                android:textColor="@color/white"
                                android:textSize="@dimen/type_section" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Desk.Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="m2" />

                            <TextView
                                android:id="@+id/unitM2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="0.00"
                                android:textColor="@color/white"
                                android:textSize="@dimen/type_section" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Desk.Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="m3" />

                            <TextView
                                android:id="@+id/unitM3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="0.00"
                                android:textColor="@color/white"
                                android:textSize="@dimen/type_section" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Desk.Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="f" />

                            <TextView
                                android:id="@+id/unitF"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="0.00"
                                android:textColor="@color/white"
                                android:textSize="@dimen/type_section" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Desk.Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="f2" />

                            <TextView
                                android:id="@+id/unitF2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="0.00"
                                android:textColor="@color/white"
                                android:textSize="@dimen/type_section" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Desk.Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="f3" />

                            <TextView
                                android:id="@+id/unitF3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="0.00"
                                android:textColor="@color/white"
                                android:textSize="@dimen/type_section" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <include
                layout="@layout/include_calc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.42" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/appsPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/appsEmptyBox"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Desk.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_apps" />

                <TextView
                    style="@style/Desk.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/apps_install_hint" />
            </LinearLayout>

            <com.paperdesk.launcher.ui.DeskRecyclerView
                android:id="@+id/appsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
