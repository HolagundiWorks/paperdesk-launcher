<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_h"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_12"
    android:paddingBottom="@dimen/space_12">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/projName"
            style="@style/Desk.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/projNo"
            style="@style/Desk.Body2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:visibility="gone" />

        <TextView
            android:id="@+id/projMeta"
            style="@style/Desk.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:visibility="gone" />

        <TextView
            android:id="@+id/projCounts"
            style="@style/Desk.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4" />
    </LinearLayout>

    <TextView
        android:id="@+id/projDel"
        style="@style/Desk.IconBtn"
        android:layout_width="@dimen/icon_btn"
        android:layout_height="@dimen/icon_btn"
        android:text="x" />
</LinearLayout>
