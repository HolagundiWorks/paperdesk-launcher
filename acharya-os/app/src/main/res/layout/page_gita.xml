<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/page_pad_h"
    android:paddingTop="@dimen/page_pad_top"
    android:paddingRight="@dimen/page_pad_h"
    android:paddingBottom="@dimen/page_pad_bottom">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.38"
        android:orientation="vertical">

        <TextView
            android:id="@+id/gitaTitle"
            style="@style/Desk.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/page_gita" />

        <TextView
            android:id="@+id/gitaMeta"
            style="@style/Desk.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/gita_meta" />

        <com.paperdesk.launcher.ui.DeskRecyclerView
            android:id="@+id/gitaChapters"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/space_8"
            android:overScrollMode="never" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/space_16"
        android:layout_weight="0.62"
        android:orientation="vertical">

        <TextView
            android:id="@+id/gitaVerseHead"
            style="@style/Desk.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/accent" />

        <com.paperdesk.launcher.ui.DeskScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_8"
                android:paddingBottom="@dimen/space_8">

                <TextView
                    android:id="@+id/gitaSlok"
                    style="@style/Desk.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/gitaTr"
                    style="@style/Desk.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8" />

                <TextView
                    android:id="@+id/gitaEn"
                    style="@style/Desk.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12" />

                <TextView
                    android:id="@+id/gitaHi"
                    style="@style/Desk.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textColor="@color/white_70" />
            </LinearLayout>
        </com.paperdesk.launcher.ui.DeskScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/gitaPlay"
                style="@style/Desk.Button.Accent"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch"
                android:layout_marginRight="@dimen/space_8"
                android:minWidth="88dp"
                android:text="@string/gita_play" />

            <TextView
                android:id="@+id/gitaPrev"
                style="@style/Desk.Button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch"
                android:minWidth="88dp"
                android:text="@string/gita_prev" />

            <TextView
                android:id="@+id/gitaNext"
                style="@style/Desk.Button.Accent"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch"
                android:layout_marginLeft="@dimen/space_8"
                android:minWidth="88dp"
                android:text="@string/gita_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
