<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_h"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_12"
    android:paddingBottom="@dimen/space_12">

    <TextView
        android:id="@+id/eventTime"
        style="@style/Desk.Body"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:textColor="@color/accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/eventTitle"
            style="@style/Desk.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/eventProject"
            style="@style/Desk.Tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:visibility="gone" />

        <TextView
            android:id="@+id/eventNotes"
            style="@style/Desk.Body2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/eventOpen"
        style="@style/Desk.Link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/open_project"
        android:visibility="gone" />

    <TextView
        android:id="@+id/eventMark"
        style="@style/Desk.Link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OPEN" />

    <TextView
        android:id="@+id/eventDelete"
        style="@style/Desk.IconBtn"
        android:layout_width="@dimen/icon_btn"
        android:layout_height="@dimen/icon_btn"
        android:text="x" />
</LinearLayout>
