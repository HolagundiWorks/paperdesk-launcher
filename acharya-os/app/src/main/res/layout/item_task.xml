<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_h"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_12"
    android:paddingBottom="@dimen/space_12">

    <CheckBox
        android:id="@+id/taskCheck"
        android:layout_width="@dimen/touch"
        android:layout_height="@dimen/touch"
        android:button="@drawable/bg_checkbox"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_8"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/taskText"
            style="@style/Desk.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2" />

        <TextView
            android:id="@+id/taskProject"
            style="@style/Desk.Tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:visibility="gone" />

        <TextView
            android:id="@+id/taskMeta"
            style="@style/Desk.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:textColor="@color/white"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/taskOpen"
        style="@style/Desk.Link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/open_project"
        android:visibility="gone" />

    <TextView
        android:id="@+id/taskDelete"
        style="@style/Desk.IconBtn"
        android:layout_width="@dimen/icon_btn"
        android:layout_height="@dimen/icon_btn"
        android:text="x" />
</LinearLayout>
