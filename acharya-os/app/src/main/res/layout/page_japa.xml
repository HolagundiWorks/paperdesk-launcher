<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/black" android:orientation="horizontal"
    android:paddingLeft="@dimen/page_pad_h" android:paddingRight="@dimen/page_pad_h" android:paddingBottom="@dimen/footer_bar">
    <ScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.46" android:fillViewport="true" android:scrollbars="none" android:paddingRight="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/japaRitualTitle" style="@style/Desk.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಜಪ ಪೂರ್ವ ಕ್ರಮ" />
            <TextView style="@style/Desk.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:lineSpacingExtra="4dp" android:text="೧  ಶೌಚ, ಶುದ್ಧ ಸ್ಥಳ ಮತ್ತು ಸ್ಥಿರ ಆಸನ&#10;&#10;೨  ಶ್ರೀಹರಿ–ಗುರು ಸ್ಮರಣೆ&#10;&#10;೩  ಆಚಮನ — ಕೇಶವದಿಂದ ಶ್ರೀಕೃಷ್ಣವರೆಗೆ ಚತುರ್ವಿಂಶತಿ ನಾಮಗಳು&#10;&#10;೪  ಪ್ರಾಣಾಯಾಮ ಮತ್ತು ಮನಸ್ಸಿನ ಏಕಾಗ್ರತೆ&#10;&#10;೫  ಸಂಕಲ್ಪ — ಮಂತ್ರ, ಉದ್ದೇಶ ಮತ್ತು ಇಂದಿನ ಗುರಿ&#10;&#10;೬  ಗುರು ಉಪದೇಶಿಸಿದ್ದರೆ ಮಾತ್ರ ವಿನಿಯೋಗ, ಕರನ್ಯಾಸ, ಅಂಗನ್ಯಾಸ ಮತ್ತು ಧ್ಯಾನ&#10;&#10;೭  ನಿಗದಿತ ಮಂತ್ರ ಜಪ&#10;&#10;೮  ಜಪ ಸಮರ್ಪಣೆ — ಸರ್ವಂ ಶ್ರೀಮನ್ನಾರಾಯಣಾರ್ಪಣಮಸ್ತು" />
            <TextView style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="ಬೀಜ/ದೀಕ್ಷಾ ಮಂತ್ರಗಳ ವಿಧಾನವನ್ನು ಗುರು ಉಪದೇಶದಂತೆ ಮಾತ್ರ ಆಚರಿಸಿ. ಎಲ್ಲಾ ಮಂತ್ರಗಳಿಗೂ ಒಂದೇ ನ್ಯಾಸ ಅನ್ವಯಿಸುವುದಿಲ್ಲ." />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.54" android:gravity="center_horizontal" android:orientation="vertical">
        <TextView android:id="@+id/japaTitle" style="@style/Desk.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಜಪ ಎಣಿಕೆ" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
            <EditText android:id="@+id/japaMantra" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@drawable/bg_input" android:hint="ಮಂತ್ರದ ಹೆಸರು" android:padding="8dp" android:singleLine="true" android:textColor="@color/white" android:textColorHint="@color/white_55" />
            <EditText android:id="@+id/japaTarget" android:layout_width="112dp" android:layout_height="36dp" android:layout_marginLeft="8dp" android:background="@drawable/bg_input" android:hint="ಗುರಿ" android:inputType="number" android:maxLength="18" android:padding="8dp" android:singleLine="true" android:textColor="@color/white" android:textColorHint="@color/white_55" />
        </LinearLayout>
        <TextView android:id="@+id/japaTap" android:layout_width="96dp" android:layout_height="96dp" android:layout_marginTop="6dp" android:background="@drawable/bg_circle_fill" android:contentDescription="ಒಂದು ಜಪ ಸೇರಿಸಿ" android:gravity="center" android:text="ಜಪ +೧" android:textColor="@color/black" android:textSize="18sp" />
        <TextView android:id="@+id/japaCurrent" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="0" android:textColor="@color/white" android:textSize="24sp" />
        <TextView android:id="@+id/japaProgress" style="@style/Desk.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:orientation="horizontal">
            <TextView android:id="@+id/japa108" style="@style/Desk.Button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="+೧೦೮" />
            <TextView android:id="@+id/japaUndo" style="@style/Desk.Button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:layout_weight="1" android:gravity="center" android:text="ಹಿಂದಕ್ಕೆ −೧" />
            <TextView android:id="@+id/japaComplete" style="@style/Desk.Button.Accent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:layout_weight="1" android:gravity="center" android:text="ಅವಧಿ ದಾಖಲಿಸು" />
            <TextView android:id="@+id/japaReset" style="@style/Desk.Button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:layout_weight="1" android:gravity="center" android:text="ಮರುಹೊಂದಿಸು" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
            <TextView android:id="@+id/japaLifetime" style="@style/Desk.Meta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <TextView android:id="@+id/japaSessions" style="@style/Desk.Meta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
