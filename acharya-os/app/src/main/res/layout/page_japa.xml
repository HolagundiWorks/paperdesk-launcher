<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/black" android:orientation="horizontal"
    android:paddingLeft="@dimen/page_pad_h" android:paddingTop="@dimen/page_pad_top"
    android:paddingRight="@dimen/page_pad_h" android:paddingBottom="@dimen/footer_bar">

    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:orientation="vertical" android:paddingRight="@dimen/space_16">

        <TextView android:id="@+id/japaTitle" style="@style/Desk.Title"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/japaRitualTitle" style="@style/Desk.Meta"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:gravity="center_vertical" android:text="ಜಪ  ›  ಜಪದ ಕ್ರಮ" android:textColor="@color/white_55" />
            <Spinner android:id="@+id/japaRitual" android:layout_width="220dp" android:layout_height="36dp"
                android:background="@drawable/bg_dropdown" android:popupBackground="@color/surface_2" android:spinnerMode="dropdown" />
            <Spinner android:id="@+id/japaProfile" android:layout_width="200dp" android:layout_height="36dp"
                android:layout_marginLeft="@dimen/space_8" android:background="@drawable/bg_dropdown"
                android:popupBackground="@color/surface_2" android:spinnerMode="dropdown" />
        </LinearLayout>

        <TextView android:id="@+id/japaProfileMeta" style="@style/Desk.Meta"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
        <TextView android:id="@+id/japaSankalpa" style="@style/Desk.Body2"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4"
            android:ellipsize="end" android:maxLines="1" android:textColor="@color/accent" />
        <TextView android:id="@+id/japaRitualBody" style="@style/Desk.Body2"
            android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="@dimen/space_4"
            android:ellipsize="end" android:gravity="center_vertical" android:lineSpacingExtra="1dp"
            android:maxLines="3" android:textColor="@color/white_70" android:textSize="15sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal">
            <Spinner android:id="@+id/japaMantra" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@drawable/bg_dropdown"
                android:popupBackground="@color/surface_2" android:spinnerMode="dropdown" />
            <CheckBox android:id="@+id/japaTargetEnabled" style="@style/Desk.Check"
                android:layout_width="132dp" android:layout_height="match_parent" android:layout_marginLeft="6dp"
                android:gravity="center_vertical" android:text="ಗುರಿ ಸಕ್ರಿಯ" android:textColor="@color/white" android:textSize="16sp" />
            <EditText android:id="@+id/japaTarget" android:layout_width="104dp" android:layout_height="match_parent"
                android:layout_marginLeft="4dp" android:background="@drawable/bg_input" android:hint="ಗುರಿ"
                android:inputType="number" android:maxLength="18" android:padding="8dp" android:singleLine="true"
                android:textColor="@color/white" android:textColorHint="@color/white_55" android:textSize="18sp" />
        </LinearLayout>

        <TextView android:id="@+id/japaCurrent" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4" android:gravity="center" android:text="೦"
            android:textColor="@color/white" android:textSize="30sp" />
        <TextView android:id="@+id/japaProgress" style="@style/Desk.Meta"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
            android:layout_marginTop="@dimen/space_4" android:orientation="horizontal">
            <TextView android:id="@+id/japa108" style="@style/Desk.Button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="+೧೦೮" android:textSize="18sp" />
            <TextView android:id="@+id/japaUndo" style="@style/Desk.Button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:layout_weight="1" android:contentDescription="ಒಂದು ಎಣಿಕೆ ಹಿಂದಕ್ಕೆ" android:gravity="center" android:text="−೧" android:textSize="18sp" />
            <TextView android:id="@+id/japaComplete" style="@style/Desk.Button.Accent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:layout_weight="1.4" android:contentDescription="ಜಪ ಅವಧಿ ದಾಖಲಿಸು" android:gravity="center" android:text="ದಾಖಲಿಸು" android:textSize="18sp" />
            <TextView android:id="@+id/japaReset" style="@style/Desk.Button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:layout_weight="1" android:contentDescription="ಪ್ರಸ್ತುತ ಜಪ ಎಣಿಕೆಯನ್ನು ಮರುಹೊಂದಿಸು" android:gravity="center" android:text="ಶೂನ್ಯ" android:textSize="18sp" />
        </LinearLayout>
        <TextView android:id="@+id/japaSessions" style="@style/Desk.Meta"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:gravity="end" />
    </LinearLayout>

    <TextView android:id="@+id/japaTap" style="@style/Desk.Button.Accent"
        android:layout_width="220dp" android:layout_height="match_parent" android:contentDescription="ಒಂದು ಜಪ ಸೇರಿಸಿ"
        android:gravity="center" android:text="ಜಪ\n+೧" android:textColor="@color/black" android:textSize="32sp" />
</LinearLayout>
