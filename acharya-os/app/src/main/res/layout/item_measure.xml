<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_h"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_8"
    android:paddingBottom="@dimen/space_8">

    <TextView
        android:id="@+id/mNo"
        style="@style/Desk.Table"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="end" />

    <TextView
        android:id="@+id/mDesc"
        style="@style/Desk.Table"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="1"
        android:paddingLeft="@dimen/space_8"
        android:paddingRight="@dimen/space_8" />

    <TextView
        android:id="@+id/mLen"
        style="@style/Desk.Table"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:gravity="end" />

    <TextView
        android:id="@+id/mBrd"
        style="@style/Desk.Table"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:gravity="end" />

    <TextView
        android:id="@+id/mHt"
        style="@style/Desk.Table"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:gravity="end" />

    <TextView
        android:id="@+id/mUom"
        style="@style/Desk.Table"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/white_55" />

    <TextView
        android:id="@+id/mKind"
        style="@style/Desk.Table"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/white_55" />

    <TextView
        android:id="@+id/mQty"
        style="@style/Desk.Table"
        android:layout_width="92dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="@dimen/type_body" />

    <TextView
        android:id="@+id/mDel"
        style="@style/Desk.IconBtn"
        android:layout_width="@dimen/icon_btn"
        android:layout_height="@dimen/icon_btn"
        android:text="x" />
</LinearLayout>
