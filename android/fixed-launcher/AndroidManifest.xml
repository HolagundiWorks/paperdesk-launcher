<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.samsung.fixedlauncher">
    <queries>
        <package android:name="com.donnnno.arcticons" />
        <package android:name="org.fossify.gallery" />
        <package android:name="org.fossify.calendar" />
        <package android:name="org.fossify.clock" />
        <package android:name="org.fossify.notes" />
        <package android:name="org.tasks" />
        <package android:name="org.fossify.math" />
        <package android:name="org.fossify.filemanager" />
        <package android:name="ua.acclorite.book_story" />
    </queries>
    <application
        android:allowBackup="false"
        android:label="Fixed Launcher"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
