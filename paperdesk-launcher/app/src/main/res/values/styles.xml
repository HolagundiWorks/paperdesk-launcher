<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PaperdeskLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="Paperdesk.Label" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Paperdesk.QuickApp" parent="">
        <item name="android:background">@drawable/quick_app_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:padding">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Paperdesk.PrimaryAction" parent="">
        <item name="android:background">@drawable/primary_action_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/canvas</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
