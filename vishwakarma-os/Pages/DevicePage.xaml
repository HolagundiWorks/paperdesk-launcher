<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PaperDesk_Companion.Pages.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Device" />
        <StackPanel Grid.Row="1" Spacing="8" MaxWidth="480" HorizontalAlignment="Left">
            <Button HorizontalAlignment="Stretch" Click="Sync_Click" Content="Sync now" Style="{StaticResource AccentButtonStyle}" />
            <Button HorizontalAlignment="Stretch" Click="Backup_Click" Content="Backup" />
            <Button HorizontalAlignment="Stretch" Click="Restore_Click" Content="Restore" />
            <Button HorizontalAlignment="Stretch" Click="Install_Click" Content="Install update (APK)" />
            <Button HorizontalAlignment="Stretch" Click="Reboot_Click" Content="Restart device" />
            <Button HorizontalAlignment="Stretch" Click="Recovery_Click" Content="Reboot recovery" />
            <TextBlock
                Margin="0,8,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="OS package updates are enabled for APK sideload. Full ROM OTA stays off until the build supports a safe rollback."
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
