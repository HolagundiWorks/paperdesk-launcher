<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PaperDesk_Companion.Pages.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PaperDesk_Companion.Models">
    <Grid Style="{StaticResource PageRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Schedule" />
            <CommandBar HorizontalAlignment="Right" DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed">
                <AppBarButton Click="New_Click" Icon="Add" Label="New" />
                <AppBarButton Click="Edit_Click" Icon="Edit" Label="Edit" />
                <AppBarButton Click="Delete_Click" Icon="Delete" Label="Delete" />
            </CommandBar>
        </Grid>
        <ListView x:Name="List" Grid.Row="1" ItemsSource="{x:Bind Session.Schedules, Mode=OneWay}" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ScheduleRow">
                    <Grid Padding="0,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Time}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Title}" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Project}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Date}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind DoneLabel}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
