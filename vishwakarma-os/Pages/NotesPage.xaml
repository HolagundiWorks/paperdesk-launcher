<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PaperDesk_Companion.Pages.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PaperDesk_Companion.Models">
    <Grid Style="{StaticResource PageRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Notes" />
            <CommandBar HorizontalAlignment="Right" DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed">
                <AppBarButton Click="New_Click" Icon="Add" Label="New" />
                <AppBarButton Click="Edit_Click" Icon="Edit" Label="Edit" />
                <AppBarButton Click="Delete_Click" Icon="Delete" Label="Delete" />
            </CommandBar>
        </Grid>
        <ListView x:Name="List" Grid.Row="1" ItemsSource="{x:Bind Session.Notes, Mode=OneWay}" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:NoteRow">
                    <StackPanel Padding="0,8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Project}" />
                        <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind PhotoLabel}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
