<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PaperDesk_Companion.Pages.SyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Synchronization" />
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                USB is the transport. Sync now exports the phone bundle, then the PC fetches Hospet weather and writes it to the phone. Push to phone sends the bundle and a fresh weather snapshot.
            </TextBlock>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Click="Sync_Click" Content="Sync now" Style="{StaticResource AccentButtonStyle}" />
            <Button Click="Push_Click" Content="Push to phone" />
        </StackPanel>
    </Grid>
</Page>
