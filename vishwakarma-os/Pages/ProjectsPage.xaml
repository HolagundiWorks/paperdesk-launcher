<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PaperDesk_Companion.Pages.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PaperDesk_Companion.Controls"
    xmlns:models="using:PaperDesk_Companion.Models">
    <Grid Style="{StaticResource PageRootStyle}">
        <Grid x:Name="ListState">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Projects" />
                <CommandBar HorizontalAlignment="Right" DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed">
                    <AppBarButton Click="New_Click" Icon="Add" Label="New" />
                    <AppBarButton Click="Open_Click" Icon="OpenFile" Label="Open" />
                    <AppBarButton Click="Edit_Click" Icon="Edit" Label="Edit" />
                    <AppBarButton Click="Delete_Click" Icon="Delete" Label="Delete" />
                </CommandBar>
            </Grid>
            <ListView
                x:Name="ProjectList"
                Grid.Row="1"
                DoubleTapped="ProjectList_DoubleTapped"
                IsItemClickEnabled="True"
                ItemClick="ProjectList_ItemClick"
                ItemsSource="{x:Bind Session.Projects, Mode=OneWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProjectRow">
                        <Grid Padding="0,8" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Counts}" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Number}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Updated}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid x:Name="DetailState" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Click="Back_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72B;" />
                            <TextBlock Text="Back" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="DetailTitle"
                        Style="{StaticResource TitleTextBlockStyle}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Pivot x:Name="DetailPivot" Grid.Row="1" Margin="0,8,0,0">
                <PivotItem Header="Measurement Book">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CommandBar DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed">
                            <AppBarButton Click="MeasNew_Click" Icon="Add" Label="New" />
                            <AppBarButton Click="MeasEdit_Click" Icon="Edit" Label="Edit" />
                            <AppBarButton Click="MeasDelete_Click" Icon="Delete" Label="Delete" />
                        </CommandBar>
                        <ListView
                            x:Name="MeasList"
                            Grid.Row="1"
                            ItemsSource="{x:Bind Session.Measurements, Mode=OneWay}"
                            SelectionMode="Single">
                            <ListView.Header>
                                <Grid Padding="12,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No." />
                                    <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Description" />
                                    <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="L" />
                                    <TextBlock Grid.Column="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="B" />
                                    <TextBlock Grid.Column="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="H" />
                                    <TextBlock Grid.Column="5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="UOM" />
                                    <TextBlock Grid.Column="6" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Type" />
                                    <TextBlock Grid.Column="7" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" Text="Qty" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:MeasureRow">
                                    <Grid Padding="12,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Item}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Length}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Breadth}" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind Height}" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind Uom}" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind Kind}" />
                                        <TextBlock Grid.Column="7" HorizontalAlignment="Right" Text="{x:Bind Qty}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="MeasTotal"
                            Grid.Row="2"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>
                </PivotItem>
                <PivotItem Header="Notes">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <CommandBar DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed">
                            <AppBarButton Click="PNoteNew_Click" Icon="Add" Label="New" />
                            <AppBarButton Click="PNotePhoto_Click" Icon="Camera" Label="Photo" />
                            <AppBarButton Click="PNoteEdit_Click" Icon="Edit" Label="Edit" />
                            <AppBarButton Click="PNoteDelete_Click" Icon="Delete" Label="Delete" />
                        </CommandBar>
                        <ListView x:Name="PNoteList" Grid.Row="1" ItemsSource="{x:Bind Session.ProjectNotes, Mode=OneWay}" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:NoteRow">
                                    <StackPanel Padding="0,8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Updated}" />
                                        <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind PhotoLabel}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </PivotItem>
                <PivotItem Header="Minutes">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <CommandBar DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed">
                            <AppBarButton Click="PMinNew_Click" Icon="Add" Label="New" />
                            <AppBarButton Click="PMinEdit_Click" Icon="Edit" Label="Edit" />
                            <AppBarButton Click="PMinDelete_Click" Icon="Delete" Label="Delete" />
                        </CommandBar>
                        <ListView x:Name="PMinList" Grid.Row="1" ItemsSource="{x:Bind Session.ProjectMinutes, Mode=OneWay}" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:MinutesRow">
                                    <StackPanel Padding="0,8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Meta}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </PivotItem>
                <PivotItem Header="Schedule">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <CommandBar DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed">
                            <AppBarButton Click="PSchedNew_Click" Icon="Add" Label="New" />
                            <AppBarButton Click="PSchedEdit_Click" Icon="Edit" Label="Edit" />
                            <AppBarButton Click="PSchedDelete_Click" Icon="Delete" Label="Delete" />
                        </CommandBar>
                        <ListView x:Name="PSchedList" Grid.Row="1" ItemsSource="{x:Bind Session.ProjectSchedules, Mode=OneWay}" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ScheduleRow">
                                    <Grid Padding="0,8" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Time}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" />
                                        <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Date}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </PivotItem>
                <PivotItem Header="Todo">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <CommandBar DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed">
                            <AppBarButton Click="PTodoNew_Click" Icon="Add" Label="New" />
                            <AppBarButton Click="PTodoEdit_Click" Icon="Edit" Label="Edit" />
                            <AppBarButton Click="PTodoDelete_Click" Icon="Delete" Label="Delete" />
                        </CommandBar>
                        <controls:TodoBoard x:Name="PTodoBoard" Grid.Row="1" ProjectScoped="True" />
                    </Grid>
                </PivotItem>
            </Pivot>
        </Grid>
    </Grid>
</Page>
