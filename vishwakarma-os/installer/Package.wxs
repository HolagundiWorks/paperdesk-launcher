<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Vishwakarma"
      Manufacturer="PaperDesk"
      Version="1.1.0"
      UpgradeCode="8f3c2a91-6d4e-4b17-9a5c-2e8f1d0b7c44"
      Language="1033"
      Scope="perMachine">
    <SummaryInformation
        Description="USB companion for the Vishwakarma phone OS"
        Manufacturer="PaperDesk" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of Vishwakarma is already installed."
        AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="!(bindpath.assets)\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPCOMMENTS" Value="USB companion for the Vishwakarma phone OS" />
    <Property Id="ARPURLINFOABOUT" Value="https://srsmatha.org" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Vishwakarma" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Vishwakarma">
        <Component Id="StartMenuShortcut" Guid="b2e91c04-7a55-4d8e-9f12-3c6a8e0d1b77">
          <Shortcut
              Id="AppShortcut"
              Name="Vishwakarma"
              Description="Vishwakarma companion"
              Target="[INSTALLFOLDER]Vishwakarma.exe"
              WorkingDirectory="INSTALLFOLDER"
              Icon="AppIcon" />
          <RemoveFolder Id="AppMenuFolder" On="uninstall" />
          <RegistryValue
              Root="HKMU"
              Key="Software\PaperDesk\Vishwakarma"
              Name="installed"
              Type="integer"
              Value="1"
              KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="c1d4a8e6-2f90-4b3a-8e71-9d5c4a1b0e22">
        <Shortcut
            Id="DesktopAppShortcut"
            Name="Vishwakarma"
            Description="Vishwakarma companion"
            Target="[INSTALLFOLDER]Vishwakarma.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon" />
        <RegistryValue
            Root="HKMU"
            Key="Software\PaperDesk\Vishwakarma"
            Name="desktop"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Vishwakarma" AllowAbsent="no" AllowAdvertise="no">
      <Files Include="!(bindpath.publish)**" Directory="INSTALLFOLDER" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>
</Wix>
